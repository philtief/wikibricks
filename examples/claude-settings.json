{
  "_comment": "Merge these hooks into ~/.claude/settings.json. Replace /PATH/TO/wikibricks with the absolute checkout path. Run `uv sync --extra dev` first and set WIKIBRICKS_DATABASE_URL in your shell or Claude environment.",
  "hooks": {
    "SessionStart":     [{"matcher": "", "hooks": [{"type": "command", "command": "/PATH/TO/wikibricks/.venv/bin/wikibricks-hook", "timeout": 60}]}],
    "UserPromptSubmit": [{"matcher": "", "hooks": [{"type": "command", "command": "/PATH/TO/wikibricks/.venv/bin/wikibricks-hook", "timeout": 5}]}],
    "PostToolUse":      [{"matcher": "", "hooks": [{"type": "command", "command": "/PATH/TO/wikibricks/.venv/bin/wikibricks-hook", "timeout": 5}]}],
    "Stop":             [{"matcher": "", "hooks": [{"type": "command", "command": "/PATH/TO/wikibricks/.venv/bin/wikibricks-hook", "timeout": 30}]}],
    "SessionEnd":       [{"matcher": "", "hooks": [{"type": "command", "command": "/PATH/TO/wikibricks/.venv/bin/wikibricks-hook", "timeout": 30}]}]
  }
}
