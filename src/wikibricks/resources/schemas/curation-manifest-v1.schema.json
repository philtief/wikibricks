{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wikibricks.dev/schemas/curation-manifest-v1.schema.json",
  "title": "WikiBricks curation manifest version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "replica_id",
    "input_watermark",
    "patches",
    "manifest_hash"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "format": "uuid"},
    "replica_id": {"type": "string", "format": "uuid"},
    "input_watermark": {"type": "integer", "minimum": 0},
    "manifest_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "patches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "patch_id",
          "group_id",
          "position",
          "operation",
          "path",
          "base_version_id",
          "base_content_hash",
          "proposal",
          "proposed_hash",
          "evidence_ids",
          "reason",
          "risk_class"
        ],
        "properties": {
          "patch_id": {"type": "string", "format": "uuid"},
          "group_id": {"type": "string", "format": "uuid"},
          "position": {"type": "integer", "minimum": 0},
          "operation": {
            "enum": [
              "create_page",
              "update_page",
              "retarget_links",
              "add_alias",
              "supersede_page"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^[^/]+(?:/[^/]+)+$"
          },
          "base_version_id": {
            "type": ["string", "null"],
            "format": "uuid"
          },
          "base_content_hash": {
            "anyOf": [
              {"type": "null"},
              {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            ]
          },
          "proposal": {"type": "object"},
          "proposed_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "reason": {"type": "string", "minLength": 1},
          "risk_class": {"enum": ["low", "medium", "high"]}
        }
      }
    }
  }
}
